{
	admin 127.0.0.1:2019
	# Upstream error logs also include request URI and headers.
	log default {
		format filter {
			request>uri query {
				delete t
				delete token
			}
			request>headers>Referer delete
		}
	}
	servers {
		protocols h1 h2 h3
		# Official Cloudflare ranges, verified 2026-10-17. Update from:
		# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

# Internal readiness endpoint; port 8080 is never published.
http://:8080 {
	respond /healthz "ok" 200
}

{$DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		-X-Powered-By
	}
	request_body {
		max_size 10MB
	}

	# Preserve the prefix. Django's URL patterns already include /api/.
	@django path /api /api/* /django-admin /django-admin/* /static/*
	handle @django {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	# Public by design for this pilot: possession of a URL grants access.
	# No directory listing and no executable upload types are accepted by Django.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy frontend:8080
	}
}

# YouthCapital has a literal hostname; the edge DOMAIN still belongs to AgroZanjir.
import /etc/caddy/youthcapital/site.caddy
