{
	email {$ACME_EMAIL}
	# Upstream error logs also include request URI and headers.
	log default {
		format filter {
			request>uri query {
				delete t
				delete token
			}
			request>headers>Referer delete
		}
	}
	servers {
		protocols h1 h2 h3
		# Official Cloudflare ranges, verified 2026-10-17. Update from:
		# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip
	log {
		format filter {
			request>uri query {
				delete t
				delete token
			}
			request>headers>Referer delete
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}

	@backend path /api /api/* /django-admin /django-admin/* /static /static/*
	handle @backend {
		request_body {
			# The app supports 500 MB videos; allow multipart overhead too.
			max_size 550MB
		}
		reverse_proxy 127.0.0.1:8000 {
			# Django receives exactly one verified address, not the CDN chain.
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle_path /media/* {
		root * /opt/youthcapital/data/media
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
			Cross-Origin-Resource-Policy same-site
			Referrer-Policy no-referrer
		}
		file_server
	}

	# Private uploads have one authenticated API route, never a file server.
	@private path /private-media /private-media/*
	handle @private {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
